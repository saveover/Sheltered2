<Window
    x:Class="SaveOver.Sheltered2.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- The TitleBar control owns the caption strip: it places the icon, title, back button
             and pane toggle, and keeps clear of the caption buttons on its own. Handing it to
             Window.SetTitleBar makes the strip draggable except where those buttons sit. -->
        <TitleBar x:Name="AppTitleBar"
                  Title="SaveOver for Sheltered 2"
                  IsBackButtonVisible="False"
                  IsPaneToggleButtonVisible="True"
                  BackRequested="OnTitleBarBackRequested"
                  PaneToggleRequested="OnTitleBarPaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource  ImageSource="ms-appx:///Assets/AppIcons/AppIcon-Dark.ico"/>
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Main view. The back and pane buttons come from the TitleBar above, so NavigationView
             must not draw its own or there would be two of each. -->
        <NavigationView x:Name="NavigationViewControl"
                        Grid.Row="1"
                        IsTabStop="False"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        SelectionChanged="OnNavigationViewSelectionChanged"
                        BackRequested="OnNavigationViewBackRequested">

            <Frame x:Name="RootFrame"
                   Navigated="OnNavigated"
                   NavigationFailed="OnNavigationFailed">
            </Frame>

            <NavigationView.MenuItems>
                <NavigationViewItem Tag="Home" 
                                    Content="Home">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItemSeparator />

                <NavigationViewItem Tag="Characters"
                                    Content="Characters">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="People" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Tag="Pets"
                                    Content="Pets">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA79;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Tag="Inventory"
                                    Content="Inventory">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Tag="Crafting"
                                    Content="Crafting">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Repair" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem Tag="Factions"
                                    Content="Factions">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Flag" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItemSeparator />
                <NavigationViewItem Tag="Donate"
                                    Content="Donate">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEB52;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
        </NavigationView>
    </Grid>
</Window>
