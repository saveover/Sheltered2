<Page
    x:Class="SaveOver.Sheltered2.Pages.CharactersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI"
    xmlns:converters="using:SaveOver.Sheltered2.Converters"
    xmlns:models="using:SaveOver.Sheltered2.Models"
    xmlns:vm="using:SaveOver.Sheltered2.ViewModels"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <converters:Int32NumberConverter x:Key="Int32NumberConverter"/>
        <converters:PercentageNumberConverter x:Key="PercentageNumberConverter"/>
    </Page.Resources>

    <!-- Two groups: Basics/Health/Needs/Relationships left, Stats/Skills right. Breakpoints use
         the capped content width rather than the window or page width, so opening the navigation
         pane and centring the editor cannot activate a layout its cards are too narrow to hold. -->
    <Grid x:Name="PageRoot">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <toolkit:ControlSizeTrigger TargetElement="{x:Bind RootGrid}" MinWidth="0" MaxWidth="850"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="LeftColumnHost.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="RightColumnHost.(Grid.Row)" Value="2"/>
                        <Setter Target="RightColumnHost.(Grid.Column)" Value="0"/>
                        <Setter Target="RightColumnHost.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="BasicsCard.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="HealthCard.(Grid.Row)" Value="1"/>
                        <Setter Target="HealthCard.(Grid.Column)" Value="0"/>
                        <Setter Target="HealthCard.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="NeedsSecondaryGrid.(Grid.Row)" Value="1"/>
                        <Setter Target="NeedsSecondaryGrid.(Grid.Column)" Value="0"/>
                        <Setter Target="NeedsSecondaryGrid.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="NeedsSecondaryGrid.Margin" Value="0,8,0,0"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="MediumLayout">
                    <VisualState.StateTriggers>
                        <toolkit:ControlSizeTrigger TargetElement="{x:Bind RootGrid}" MinWidth="850" MaxWidth="1200"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <!-- Single column, but Basics | Health side by side (InfoGrid default). -->
                        <Setter Target="LeftColumnHost.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="RightColumnHost.(Grid.Row)" Value="2"/>
                        <Setter Target="RightColumnHost.(Grid.Column)" Value="0"/>
                        <Setter Target="RightColumnHost.(Grid.ColumnSpan)" Value="2"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <toolkit:ControlSizeTrigger TargetElement="{x:Bind RootGrid}" MinWidth="1200"/>
                    </VisualState.StateTriggers>
                    <!-- Default markup already places the two groups in two columns. -->
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Outside the scroller, so it stays put while the cards move under it. -->
        <TextBlock Margin="36,24,36,0"
                   MaxWidth="{StaticResource WidePageContentMaxWidth}"
                   Text="Characters"
                   Style="{StaticResource TitleTextBlockStyle}"
                   AutomationProperties.HeadingLevel="Level1"/>

        <ScrollView Grid.Row="1">
        <Grid x:Name="RootGrid"
              Margin="36,16,36,36"
              MaxWidth="{StaticResource WidePageContentMaxWidth}"
              ColumnSpacing="24"
              RowSpacing="24">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition Width="6*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ComboBox x:Name="CharacterComboBox"
                      Grid.Row="0" Grid.ColumnSpan="2"
                      Header="Select a character from the drop-down menu and edit the relevant fields."
                      PlaceholderText="Select a character"
                      SelectionChanged="CharacterComboBox_SelectionChanged">
                <!-- A template rather than DisplayMemberPath: that resolves "FullName" by
                     reflection at run time, which the trimmer and AOT cannot follow (WMC1510).
                     OneWay so renaming a character updates the entry you picked them from. -->
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:Character">
                        <TextBlock Text="{x:Bind FullName, Mode=OneWay}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Left group -->
            <ContentControl x:Name="LeftColumnHost"
                            Grid.Row="1" Grid.Column="0"
                            VerticalAlignment="Top"
                            HorizontalContentAlignment="Stretch">
            <StackPanel x:Name="LeftColumn" Spacing="24">

                <!-- Basics and Health pair up in one row; they stack when narrow. -->
                <Grid ColumnSpacing="24" RowSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Basics -->
                    <Border x:Name="BasicsCard"
                            Grid.Row="0" Grid.Column="0"
                            Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Basics"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       AutomationProperties.HeadingLevel="Level2"/>
                            <TextBox x:Name="FirstNameTextBox"
                                     MaxWidth="250"
                                     HorizontalAlignment="Left"
                                     MinWidth="180"
                                     Header="First name:"
                                     PlaceholderText="Jane"
                                     MaxLength="15"
                                     LostFocus="TrimTextBox_LostFocus"
                                     Text="{x:Bind SelectedCharacter.FirstName, Mode=TwoWay, FallbackValue=''}"/>
                            <TextBox x:Name="LastNameTextBox"
                                     MaxWidth="250"
                                     MinWidth="180"
                                     HorizontalAlignment="Left"
                                     Header="Last name:"
                                     PlaceholderText="Doe"
                                     MaxLength="15"
                                     LostFocus="TrimTextBox_LostFocus"
                                     Text="{x:Bind SelectedCharacter.LastName, Mode=TwoWay, FallbackValue=''}"/>
                            <CheckBox x:Name="InteractingCheckBox" Content="Interacting"
                                      IsChecked="{x:Bind SelectedCharacter.Interacting, Mode=TwoWay, FallbackValue=False}"/>
                            <CheckBox x:Name="InteractingWithObjCheckBox" Content="Interacting with object"
                                      IsChecked="{x:Bind SelectedCharacter.InteractingWithObj, Mode=TwoWay, FallbackValue=False}"/>
                            <CheckBox x:Name="IsPsychoCheckBox" Content="Is a psychopath"
                                      IsChecked="{x:Bind SelectedCharacter.IsPsycho, Mode=TwoWay, FallbackValue=False}"/>
                        </StackPanel>
                    </Border>

                    <!-- Health and Conditions -->
                    <Border x:Name="HealthCard"
                            Grid.Row="0" Grid.Column="1"
                            Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Health and Conditions"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       AutomationProperties.HeadingLevel="Level2"/>
                            <NumberBox x:Name="CurrentHealthNumberBox"
                                       MaxWidth="250"
                                       MinWidth="180"
                                       HorizontalAlignment="Left"
                                       Header="Current health:"
                                       Minimum="1"
                                       Maximum="10000"
                                       SpinButtonPlacementMode="Inline"
                                       SmallChange="10"
                                       LargeChange="100"
                                       Value="{x:Bind SelectedCharacter.CurrentHealth, Mode=TwoWay, FallbackValue=1, Converter={StaticResource Int32NumberConverter}}"/>
                            <NumberBox x:Name="MaxHealthNumberBox"
                                       MaxWidth="250"
                                       MinWidth="180"
                                       HorizontalAlignment="Left"
                                       Header="Maximum health:"
                                       Minimum="1"
                                       Maximum="10000"
                                       SpinButtonPlacementMode="Inline"
                                       SmallChange="10"
                                       LargeChange="100"
                                       Value="{x:Bind SelectedCharacter.MaxHealth, Mode=TwoWay, FallbackValue=1, Converter={StaticResource Int32NumberConverter}}"/>
                            <CheckBox x:Name="HasBeenDefibbedCheckBox" Content="Has been defibrillated"
                                      IsChecked="{x:Bind SelectedCharacter.HasBeenDefibbed, Mode=TwoWay, FallbackValue=False}"/>
                            <CheckBox x:Name="PassedOutCheckBox" Content="Is passed out"
                                      IsChecked="{x:Bind SelectedCharacter.PassedOut, Mode=TwoWay, FallbackValue=False}"/>
                            <CheckBox x:Name="IsUnconsciousCheckBox" Content="Is unconscious"
                                      IsChecked="{x:Bind SelectedCharacter.IsUnconscious, Mode=TwoWay, FallbackValue=False}"/>

                            <!-- Applied on save; see SaveWriter.ApplyPositionResets. -->
                            <CheckBox x:Name="ResetPositionCheckBox"
                                      Content="Reset position on save (frees a stuck member)"
                                      IsChecked="{x:Bind SelectedCharacter.ResetPositionRequested, Mode=TwoWay, FallbackValue=False}"
                                      ToolTipService.ToolTip="On save, moves this member to another family member's location."/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Needs -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Needs"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   AutomationProperties.HeadingLevel="Level2"/>
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="0 means fully satisfied; 100 is critical. Values are shown as whole numbers; a need you don't change keeps its exact saved value." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="SatisfyNeedsButton"
                                    Content="Satisfy all (0)"
                                    Click="SatisfyNeedsButton_Click"/>
                            <Button x:Name="DepleteNeedsButton"
                                    Content="Deplete all (100)"
                                    Click="DepleteNeedsButton_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="NeedsFeedbackTextBlock"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <Grid x:Name="NeedsGrid" ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="&#127829; Hunger" VerticalAlignment="Center"/>
                                <NumberBox x:Name="HungerNumberBox" Grid.Column="1" Width="120"
                                           Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact" SmallChange="5"
                                           Value="{x:Bind SelectedCharacter.Hunger, Mode=TwoWay, FallbackValue=0, Converter={StaticResource PercentageNumberConverter}}"
                                           AutomationProperties.Name="Hunger"/>
                                <TextBlock Grid.Row="1" Text="&#128164; Fatigue" VerticalAlignment="Center"/>
                                <NumberBox x:Name="FatigueNumberBox" Grid.Row="1" Grid.Column="1" Width="120"
                                           Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact" SmallChange="5"
                                           Value="{x:Bind SelectedCharacter.Fatigue, Mode=TwoWay, FallbackValue=0, Converter={StaticResource PercentageNumberConverter}}"
                                           AutomationProperties.Name="Fatigue"/>
                                <TextBlock Grid.Row="2" Text="&#128701; Toilet" VerticalAlignment="Center"/>
                                <NumberBox x:Name="ToiletNumberBox" Grid.Row="2" Grid.Column="1" Width="120"
                                           Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact" SmallChange="5"
                                           Value="{x:Bind SelectedCharacter.Toilet, Mode=TwoWay, FallbackValue=0, Converter={StaticResource PercentageNumberConverter}}"
                                           AutomationProperties.Name="Toilet"/>
                            </Grid>

                            <Grid x:Name="NeedsSecondaryGrid" Grid.Column="1" ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="&#129380; Thirst" VerticalAlignment="Center"/>
                                <NumberBox x:Name="ThirstNumberBox" Grid.Column="1" Width="120"
                                           Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact" SmallChange="5"
                                           Value="{x:Bind SelectedCharacter.Thirst, Mode=TwoWay, FallbackValue=0, Converter={StaticResource PercentageNumberConverter}}"
                                           AutomationProperties.Name="Thirst"/>
                                <TextBlock Grid.Row="1" Text="&#128703; Dirtiness" VerticalAlignment="Center"/>
                                <NumberBox x:Name="DirtinessNumberBox" Grid.Row="1" Grid.Column="1" Width="120"
                                           Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact" SmallChange="5"
                                           Value="{x:Bind SelectedCharacter.Dirtiness, Mode=TwoWay, FallbackValue=0, Converter={StaticResource PercentageNumberConverter}}"
                                           AutomationProperties.Name="Dirtiness"/>
                                <TextBlock Grid.Row="2" Text="&#128543; Stress" VerticalAlignment="Center"/>
                                <NumberBox x:Name="StressNumberBox" Grid.Row="2" Grid.Column="1" Width="120"
                                           Minimum="0" Maximum="100" SpinButtonPlacementMode="Compact" SmallChange="5"
                                           Value="{x:Bind SelectedCharacter.Stress, Mode=TwoWay, FallbackValue=0, Converter={StaticResource PercentageNumberConverter}}"
                                           AutomationProperties.Name="Stress"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Relationships -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Relationships"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   AutomationProperties.HeadingLevel="Level2"/>
                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="How this character feels about the other shelter members (-100 = hostile, 100 = best friends)." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="MaxRelationshipsButton"
                                    Content="Set all to 100"
                                    Click="MaxRelationshipsButton_Click"/>
                            <Button x:Name="MinRelationshipsButton"
                                    Content="Set all to -100"
                                    Click="MinRelationshipsButton_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="RelationshipsFeedbackTextBlock"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock x:Name="NoRelationshipsTextBlock"
                                   Text="No relationships recorded for this character."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed"/>
                        <ItemsControl x:Name="RelationshipsItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RelationshipRowViewModel">
                                    <Grid ColumnSpacing="12" Margin="0,0,0,8" MaxWidth="360" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="140"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Name}"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <NumberBox Grid.Column="1" Width="120"
                                                   Minimum="-100" Maximum="100"
                                                   SpinButtonPlacementMode="Compact" SmallChange="5"
                                                   Value="{x:Bind Level, Mode=TwoWay}"
                                                   AutomationProperties.Name="{x:Bind AutomationName}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ContentControl>

            <!-- Right group -->
            <ContentControl x:Name="RightColumnHost"
                            Grid.Row="1" Grid.Column="1"
                            VerticalAlignment="Top"
                            HorizontalContentAlignment="Stretch">
            <StackPanel x:Name="RightColumn" Spacing="24">

                <!-- Fixed-width boxes so the rows stay even at any column width. -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Orientation="Vertical" Spacing="12">
                        <TextBlock Text="Stats"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   AutomationProperties.HeadingLevel="Level2"/>
                        <TextBlock TextWrapping="Wrap"
                                   Margin="0,0,0,12"
                                   Text="Each stat has a current and maximum level, referred to as the 'cap.' The current level determines the cap and cannot be directly modified to maintain game logic. For levels 1 to 5, the cap increases by 2 points for each level. Once a level exceeds 5, the cap is always 20." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="MaxStatsButton"
                                    Content="Maximise all stats"
                                    Click="MaxStatsButton_Click" />
                            <Button x:Name="MinStatsButton"
                                    Content="Minimise all stats"
                                    Click="MinStatsButton_Click" />
                        </StackPanel>
                        <TextBlock x:Name="StatsFeedbackTextBlock"
                                   Margin="0,4,0,0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   AutomationProperties.LiveSetting="Polite"/>

                        <Grid x:Name="StatsGrid" RowSpacing="8" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Column headers -->
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Current level:"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Maximum level:"
                                       Style="{StaticResource BodyStrongTextBlockStyle}"/>

                            <!-- One row per stat -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="&#128170; Strength" VerticalAlignment="Center"/>
                            <NumberBox x:Name="StrengthLevelBox" Grid.Row="1" Grid.Column="1" Width="120"
                                       Minimum="1" Maximum="20" SpinButtonPlacementMode="Compact" SmallChange="1"
                                       Value="{x:Bind SelectedCharacter.Strength.Level, Mode=TwoWay, FallbackValue=1, Converter={StaticResource Int32NumberConverter}}"
                                       AutomationProperties.Name="Strength current level"/>
                            <NumberBox x:Name="StrengthCapBox" Grid.Row="1" Grid.Column="2" Width="120" IsEnabled="False"
                                       Value="{x:Bind SelectedCharacter.Strength.Cap, Mode=OneWay, FallbackValue=1, Converter={StaticResource Int32NumberConverter}}"
                                       AutomationProperties.Name="Strength maximum level"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="&#127939; Dexterity" VerticalAlignment="Center"/>
                            <NumberBox x:Name="DexterityLevelBox" Grid.Row="2" Grid.Column="1" Width="120"
                                       Minimum="1" Maximum="20" SpinButtonPlacementMode="Compact" SmallChange="1"
                                       Value="{x:Bind SelectedCharacter.Dexterity.Level, Mode=TwoWay, FallbackValue=1, Converter={StaticResource Int32NumberConverter}}"
                                       AutomationProperties.Name="Dexterity current level"/>
                            <NumberBox x:Name="DexterityCapBox" Grid.Row="2" Grid.Column="2" Width="120" IsEnabled="False"
                                       Value="{x:Bind SelectedCharacter.Dexterity.Cap, Mode=OneWay, FallbackValue=1, Converter={StaticResource Int32NumberConverter}}"
                                       AutomationProperties.Name="Dexterity maximum level"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="&#129504; Intelligence" VerticalAlignment="Center"/>
                            <NumberBox x:Name="IntelligenceLevelBox" Grid.Row="3" Grid.Column="1" Width="120"
                                       Minimum="1" Maximum="20" SpinButtonPlacementMode="Compact" SmallChange="1"
                                       Value="{x:Bind SelectedCharacter.Intelligence.Level, Mode=TwoWay, FallbackValue=1, Converter={StaticResource Int32NumberConverter}}"
                                       AutomationProperties.Name="Intelligence current level"/>
                            <NumberBox x:Name="IntelligenceCapBox" Grid.Row="3" Grid.Column="2" Width="120" IsEnabled="False"
                                       Value="{x:Bind SelectedCharacter.Intelligence.Cap, Mode=OneWay, FallbackValue=1, Converter={StaticResource Int32NumberConverter}}"
                                       AutomationProperties.Name="Intelligence maximum level"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="&#128068; Charisma" VerticalAlignment="Center"/>
                            <NumberBox x:Name="CharismaLevelBox" Grid.Row="4" Grid.Column="1" Width="120"
                                       Minimum="1" Maximum="20" SpinButtonPlacementMode="Compact" SmallChange="1"
                                       Value="{x:Bind SelectedCharacter.Charisma.Level, Mode=TwoWay, FallbackValue=1, Converter={StaticResource Int32NumberConverter}}"
                                       AutomationProperties.Name="Charisma current level"/>
                            <NumberBox x:Name="CharismaCapBox" Grid.Row="4" Grid.Column="2" Width="120" IsEnabled="False"
                                       Value="{x:Bind SelectedCharacter.Charisma.Cap, Mode=OneWay, FallbackValue=1, Converter={StaticResource Int32NumberConverter}}"
                                       AutomationProperties.Name="Charisma maximum level"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="&#128064; Perception" VerticalAlignment="Center"/>
                            <NumberBox x:Name="PerceptionLevelBox" Grid.Row="5" Grid.Column="1" Width="120"
                                       Minimum="1" Maximum="20" SpinButtonPlacementMode="Compact" SmallChange="1"
                                       Value="{x:Bind SelectedCharacter.Perception.Level, Mode=TwoWay, FallbackValue=1, Converter={StaticResource Int32NumberConverter}}"
                                       AutomationProperties.Name="Perception current level"/>
                            <NumberBox x:Name="PerceptionCapBox" Grid.Row="5" Grid.Column="2" Width="120" IsEnabled="False"
                                       Value="{x:Bind SelectedCharacter.Perception.Cap, Mode=OneWay, FallbackValue=1, Converter={StaticResource Int32NumberConverter}}"
                                       AutomationProperties.Name="Perception maximum level"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="&#10084; Fortitude" VerticalAlignment="Center"/>
                            <NumberBox x:Name="FortitudeLevelBox" Grid.Row="6" Grid.Column="1" Width="120"
                                       Minimum="1" Maximum="20" SpinButtonPlacementMode="Compact" SmallChange="1"
                                       Value="{x:Bind SelectedCharacter.Fortitude.Level, Mode=TwoWay, FallbackValue=1, Converter={StaticResource Int32NumberConverter}}"
                                       AutomationProperties.Name="Fortitude current level"/>
                            <NumberBox x:Name="FortitudeCapBox" Grid.Row="6" Grid.Column="2" Width="120" IsEnabled="False"
                                       Value="{x:Bind SelectedCharacter.Fortitude.Cap, Mode=OneWay, FallbackValue=1, Converter={StaticResource Int32NumberConverter}}"
                                       AutomationProperties.Name="Fortitude maximum level"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Skills -->
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Skills"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       AutomationProperties.HeadingLevel="Level2"/>
                            <DropDownButton x:Name="SkillActionsButton"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Content="Bulk edit">
                                <DropDownButton.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Maximise this skill tree" Click="MaxTreeMenuItem_Click"/>
                                        <MenuFlyoutItem Text="Maximise all skill trees" Click="MaxAllTreesMenuItem_Click"/>
                                        <MenuFlyoutSeparator/>
                                        <MenuFlyoutItem Text="Remove all points in this tree" Click="ClearTreeMenuItem_Click"/>
                                        <MenuFlyoutItem Text="Remove all skill points" Click="ClearAllMenuItem_Click"/>
                                    </MenuFlyout>
                                </DropDownButton.Flyout>
                            </DropDownButton>
                        </Grid>

                        <TextBlock TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Pick a stat, then set how many points are invested in each skill. Each skill's stars show its maximum rank." />

                        <!-- SelectorBar items don't wrap, so scroll instead of clipping. -->
                        <ScrollView ContentOrientation="Horizontal"
                                    HorizontalScrollBarVisibility="Auto"
                                    VerticalScrollBarVisibility="Hidden"
                                    VerticalScrollMode="Disabled">
                            <SelectorBar x:Name="SelectorBar" SelectionChanged="SelectorBar_SelectionChanged">
                                <SelectorBarItem x:Name="SelectorBarItemStrength"
                                 Text="&#128170; Strength" Tag="Strength" IsSelected="True"/>
                                <SelectorBarItem x:Name="SelectorBarItemDexterity"
                                 Text="&#127939; Dexterity" Tag="Dexterity"/>
                                <SelectorBarItem x:Name="SelectorBarItemIntelligence"
                                 Text="&#129504; Intelligence" Tag="Intelligence"/>
                                <SelectorBarItem x:Name="SelectorBarItemCharisma"
                                 Text="&#128068; Charisma" Tag="Charisma"/>
                                <SelectorBarItem x:Name="SelectorBarItemPerception"
                                 Text="&#128064; Perception" Tag="Perception"/>
                                <SelectorBarItem x:Name="SelectorBarItemFortitude"
                                 Text="&#10084; Fortitude" Tag="Fortitude"/>
                            </SelectorBar>
                        </ScrollView>

                        <TextBlock x:Name="SkillsFeedbackTextBlock"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   AutomationProperties.LiveSetting="Polite"/>

                        <!-- One section per tier; ItemsSource set in code-behind. -->
                        <ItemsControl x:Name="SkillTiersItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SkillTierViewModel">
                                    <StackPanel Spacing="8" Margin="0,4,0,16">
                                        <TextBlock Text="{x:Bind Title}"
                                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                        <ItemsRepeater ItemsSource="{x:Bind Skills}">
                                            <ItemsRepeater.Layout>
                                                <UniformGridLayout MinItemWidth="112"
                                                                   MinColumnSpacing="12"
                                                                   MinRowSpacing="16"/>
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SkillSlotViewModel">
                                                    <!-- Fixed row heights keep the star rows aligned. -->
                                                    <Grid Width="112">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="56"/>
                                                            <RowDefinition Height="36"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <!-- Decorative; the name below carries the meaning. -->
                                                        <Image Grid.Row="0"
                                                               Source="{x:Bind Icon}"
                                                               Width="56"
                                                               Height="56"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               AutomationProperties.AccessibilityView="Raw"/>
                                                        <TextBlock Grid.Row="1"
                                                                   Text="{x:Bind Name}"
                                                                   FontSize="12"
                                                                   MaxLines="2"
                                                                   TextWrapping="Wrap"
                                                                   TextAlignment="Center"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                        <RatingControl Grid.Row="2"
                                                                       HorizontalAlignment="Center"
                                                                       MaxRating="{x:Bind MaxLevel}"
                                                                       Value="{x:Bind RatingValue, Mode=TwoWay}"
                                                                       IsClearEnabled="True"
                                                                       AutomationProperties.Name="{x:Bind Name}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ContentControl>
        </Grid>
        </ScrollView>
    </Grid>
</Page>
