<Page
    x:Class="SaveOver.Sheltered2.Pages.PetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI"
    NavigationCacheMode="Enabled">

    <!-- Basics and Training sit side by side once this page is 950 wide, stacked below that. The
         breakpoint is the page's width, not the window's, so the navigation pane opening or
         closing reflows the cards instead of being invisible to them. The groups hang off the
         page's root element: on an inner element the triggers still fire but nothing applies. -->
    <Grid x:Name="PageRoot">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <toolkit:ControlSizeTrigger TargetElement="{x:Bind PageRoot}" MinWidth="0" MaxWidth="950"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="BasicsCard.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="TrainingCard.(Grid.Row)" Value="2"/>
                        <Setter Target="TrainingCard.(Grid.Column)" Value="0"/>
                        <Setter Target="TrainingCard.(Grid.ColumnSpan)" Value="2"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <toolkit:ControlSizeTrigger TargetElement="{x:Bind PageRoot}" MinWidth="950"/>
                    </VisualState.StateTriggers>
                    <!-- Default markup already has Basics | Training side by side. -->
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Outside the scroller, so it stays put while the cards move under it. -->
        <TextBlock Margin="36,24,36,0"
                   Text="Pets"
                   Style="{StaticResource TitleTextBlockStyle}"
                   AutomationProperties.HeadingLevel="Level1"/>

        <ScrollView Grid.Row="1">
        <Grid x:Name="RootGrid" Margin="36,16,36,36" ColumnSpacing="24" RowSpacing="24"
              MaxWidth="1100" HorizontalAlignment="Left">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ComboBox x:Name="PetComboBox"
                      Grid.Row="0" Grid.ColumnSpan="2"
                      Header="Select a pet from the drop-down menu and edit the relevant fields."
                      PlaceholderText="Select a pet"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="PetComboBox_SelectionChanged"/>

            <!-- Basics -->
            <Border x:Name="BasicsCard"
                    Grid.Row="1" Grid.Column="0"
                    VerticalAlignment="Top"
                    Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Basics"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2"/>
                    <TextBox x:Name="PetNameTextBox"
                             MaxWidth="250"
                             MinWidth="180"
                             HorizontalAlignment="Left"
                             Header="Name:"
                             PlaceholderText="Daisy"
                             MaxLength="15"/>
                    <NumberBox x:Name="PetAgeNumberBox"
                               MaxWidth="250"
                               MinWidth="180"
                               HorizontalAlignment="Left"
                               Header="Age (years):"
                               Minimum="0"
                               Maximum="30"
                               SpinButtonPlacementMode="Inline"
                               SmallChange="1"/>
                    <NumberBox x:Name="PetHealthNumberBox"
                               MaxWidth="250"
                               MinWidth="180"
                               HorizontalAlignment="Left"
                               Header="Health:"
                               Minimum="1"
                               Maximum="1000"
                               SpinButtonPlacementMode="Inline"
                               SmallChange="10"/>
                    <NumberBox x:Name="PetHungerNumberBox"
                               MaxWidth="250"
                               MinWidth="180"
                               HorizontalAlignment="Left"
                               Header="Hunger (0 = full, 100 = starving):"
                               Minimum="0"
                               Maximum="100"
                               SpinButtonPlacementMode="Inline"
                               SmallChange="5"/>
                    <CheckBox x:Name="PetStarvingCheckBox" Content="Is starving"/>
                    <CheckBox x:Name="PetPoisonedCheckBox" Content="Is poisoned"/>
                    <CheckBox x:Name="PetImmuneCheckBox" Content="Is immune"/>
                </StackPanel>
            </Border>

            <!-- Training -->
            <Border x:Name="TrainingCard"
                    Grid.Row="1" Grid.Column="1"
                    VerticalAlignment="Top"
                    Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Training"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2"/>
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Each training skill has a level, a level cap, and accumulated experience." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="MaxTrainingButton"
                                Content="Maximise training"
                                Click="MaxTrainingButton_Click"/>
                        <Button x:Name="MinTrainingButton"
                                Content="Minimise training"
                                Click="MinTrainingButton_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="TrainingFeedbackTextBlock"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               AutomationProperties.LiveSetting="Polite"/>
                    <Grid RowSpacing="8" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Column headers -->
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Level:"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Level cap:"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Experience:"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Prey drive" VerticalAlignment="Center"/>
                        <NumberBox x:Name="PreyDriveLevelBox" Grid.Row="1" Grid.Column="1" Width="110"
                                   Minimum="1" Maximum="10" SpinButtonPlacementMode="Compact" SmallChange="1"
                                   AutomationProperties.Name="Prey drive level"/>
                        <NumberBox x:Name="PreyDriveCapBox" Grid.Row="1" Grid.Column="2" Width="110"
                                   Minimum="1" Maximum="10" SpinButtonPlacementMode="Compact" SmallChange="1"
                                   AutomationProperties.Name="Prey drive level cap"/>
                        <NumberBox x:Name="PreyDriveXpBox" Grid.Row="1" Grid.Column="3" Width="130"
                                   Minimum="0" Maximum="100000" SpinButtonPlacementMode="Compact" SmallChange="50"
                                   AutomationProperties.Name="Prey drive experience"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Scavenging" VerticalAlignment="Center"/>
                        <NumberBox x:Name="ScavengingLevelBox" Grid.Row="2" Grid.Column="1" Width="110"
                                   Minimum="1" Maximum="10" SpinButtonPlacementMode="Compact" SmallChange="1"
                                   AutomationProperties.Name="Scavenging level"/>
                        <NumberBox x:Name="ScavengingCapBox" Grid.Row="2" Grid.Column="2" Width="110"
                                   Minimum="1" Maximum="10" SpinButtonPlacementMode="Compact" SmallChange="1"
                                   AutomationProperties.Name="Scavenging level cap"/>
                        <NumberBox x:Name="ScavengingXpBox" Grid.Row="2" Grid.Column="3" Width="130"
                                   Minimum="0" Maximum="100000" SpinButtonPlacementMode="Compact" SmallChange="50"
                                   AutomationProperties.Name="Scavenging experience"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Affection" VerticalAlignment="Center"/>
                        <NumberBox x:Name="AffectionLevelBox" Grid.Row="3" Grid.Column="1" Width="110"
                                   Minimum="1" Maximum="10" SpinButtonPlacementMode="Compact" SmallChange="1"
                                   AutomationProperties.Name="Affection level"/>
                        <NumberBox x:Name="AffectionCapBox" Grid.Row="3" Grid.Column="2" Width="110"
                                   Minimum="1" Maximum="10" SpinButtonPlacementMode="Compact" SmallChange="1"
                                   AutomationProperties.Name="Affection level cap"/>
                        <NumberBox x:Name="AffectionXpBox" Grid.Row="3" Grid.Column="3" Width="130"
                                   Minimum="0" Maximum="100000" SpinButtonPlacementMode="Compact" SmallChange="50"
                                   AutomationProperties.Name="Affection experience"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        </ScrollView>
    </Grid>
</Page>
