<Page
    x:Class="SaveOver.Sheltered2.Pages.InventoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SaveOver.Sheltered2.Models"
    xmlns:toolkit="using:CommunityToolkit.WinUI"
    xmlns:vm="using:SaveOver.Sheltered2.ViewModels"
    NavigationCacheMode="Enabled">

    <Grid x:Name="PageRoot">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <!-- At narrow widths, move descriptive text below its compact action instead of
                     retaining a three-column layout that can clip in a narrow app window. -->
                <VisualState x:Name="NarrowLayout">
                    <VisualState.StateTriggers>
                        <toolkit:ControlSizeTrigger TargetElement="{x:Bind PageRoot}" MinWidth="0" MaxWidth="620"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="WaterContentGrid.ColumnSpacing" Value="12"/>
                        <Setter Target="WaterDetails.(Grid.Row)" Value="1"/>
                        <Setter Target="WaterDetails.(Grid.Column)" Value="0"/>
                        <Setter Target="WaterDetails.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="StoredWaterNumberBox.(Grid.Row)" Value="1"/>
                        <Setter Target="StoredWaterNumberBox.(Grid.Column)" Value="2"/>
                        <Setter Target="InventoryActionsPanel.(Grid.Row)" Value="1"/>
                        <Setter Target="InventoryActionsPanel.(Grid.Column)" Value="0"/>
                        <Setter Target="InventoryActionsPanel.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="InventoryActionsPanel.HorizontalAlignment" Value="Left"/>
                        <Setter Target="InventoryActionButtonsPanel.Orientation" Value="Vertical"/>
                        <Setter Target="InventorySaveHintTextBlock.HorizontalAlignment" Value="Left"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <toolkit:ControlSizeTrigger TargetElement="{x:Bind PageRoot}" MinWidth="620"/>
                    </VisualState.StateTriggers>
                    <!-- The markup's default positions are the wide layout. -->
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Kept outside the scroller so the current editor is always clear. -->
        <TextBlock Margin="36,24,36,0"
                   MaxWidth="{StaticResource WidePageContentMaxWidth}"
                   Text="Inventory"
                   Style="{StaticResource TitleTextBlockStyle}"
                   AutomationProperties.HeadingLevel="Level1"/>

        <ScrollView Grid.Row="1">
            <StackPanel Margin="36,16,36,36"
                        MaxWidth="{StaticResource WidePageContentMaxWidth}"
                        Spacing="24">

                <InfoBar x:Name="NoInventoryInfoBar"
                         IsOpen="False"
                         IsClosable="False"
                         Severity="Informational"
                         Title="No shelter inventory found"
                         Message="This save does not contain editable shelter inventory data."/>

                <!-- Water is a shelter resource, not an item stack. -->
                <Border x:Name="WaterCard" Style="{StaticResource CardBorderStyle}">
                    <Grid x:Name="WaterContentGrid" ColumnSpacing="20" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Width="56"
                                Height="56"
                                CornerRadius="8"
                                Background="{ThemeResource LayerFillColorDefaultBrush}">
                            <FontIcon Glyph="&#xEB42;"
                                      FontSize="28"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                      AutomationProperties.AccessibilityView="Raw"/>
                        </Border>

                        <StackPanel x:Name="WaterDetails" Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="Shelter water"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       AutomationProperties.HeadingLevel="Level2"/>
                            <TextBlock Text="Available water in the shelter. This is saved separately from item stacks."
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <NumberBox x:Name="StoredWaterNumberBox"
                                   Grid.Column="2"
                                   Width="150"
                                   Header="Units"
                                   SpinButtonPlacementMode="Inline"
                                   ValueChanged="StoredWaterNumberBox_ValueChanged"
                                   AutomationProperties.Name="Stored water"
                                   AutomationProperties.AutomationId="StoredWaterNumberBox"/>
                    </Grid>
                </Border>

                <Border x:Name="InventoryCard" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="16">
                        <Grid x:Name="InventoryHeaderGrid" ColumnSpacing="16" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock x:Name="ContainerNameTextBlock"
                                           Text="Shelter inventory"
                                           Style="{StaticResource SubtitleTextBlockStyle}"
                                           AutomationProperties.HeadingLevel="Level2"/>
                                <TextBlock x:Name="ContainerSummaryTextBlock"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel x:Name="InventoryActionsPanel"
                                        Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        Spacing="8">
                                <StackPanel x:Name="InventoryActionButtonsPanel"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                    <Button x:Name="AddItemButton"
                                            Click="AddItemButton_Click"
                                            AutomationProperties.AutomationId="AddInventoryItemButton">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <SymbolIcon Symbol="Add"
                                                        AutomationProperties.AccessibilityView="Raw"/>
                                            <TextBlock Text="Add item"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="IncreaseAllQualityButton"
                                            Click="IncreaseAllQualityButton_Click"
                                            ToolTipService.ToolTip="Set every stack in Shelter inventory and Overflow to 3 stars"
                                            AutomationProperties.AutomationId="IncreaseAllInventoryQualityButton">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <SymbolIcon Symbol="Favorite"
                                                        AutomationProperties.AccessibilityView="Raw"/>
                                            <TextBlock Text="Set all to 3 stars"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock x:Name="InventorySaveHintTextBlock"
                                           Text="Changes are saved from Home"
                                           HorizontalAlignment="Right"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <!-- SelectorBar items do not wrap; scrolling keeps all categories usable on a narrow page. -->
                        <ScrollView ContentOrientation="Horizontal"
                                    HorizontalScrollBarVisibility="Auto"
                                    VerticalScrollBarVisibility="Hidden"
                                    VerticalScrollMode="Disabled">
                            <SelectorBar x:Name="ContainerSelector"
                                         SelectionChanged="ContainerSelector_SelectionChanged"
                                         AutomationProperties.Name="Inventory container"
                                         AutomationProperties.AutomationId="InventoryContainerSelector">
                                <SelectorBarItem x:Name="StorageSelectorItem"
                                                 Text="Shelter inventory"
                                                 Tag="Storage"
                                                 IsSelected="True"/>
                                <SelectorBarItem x:Name="OverflowSelectorItem"
                                                 Text="Overflow"
                                                 Tag="Overflow"/>
                            </SelectorBar>
                        </ScrollView>

                        <ComboBox x:Name="CategoryComboBox"
                                  Width="240"
                                  HorizontalAlignment="Left"
                                  Header="Category"
                                  SelectionChanged="CategoryComboBox_SelectionChanged"
                                  AutomationProperties.Name="Filter inventory by category"
                                  AutomationProperties.AutomationId="InventoryCategoryComboBox">
                            <ComboBoxItem Content="All categories" Tag="All" IsSelected="True"/>
                            <ComboBoxItem Content="Ammunition" Tag="Ammunition"/>
                            <ComboBoxItem Content="Books" Tag="Books"/>
                            <ComboBoxItem Content="Consumables" Tag="Consumables"/>
                            <ComboBoxItem Content="Drugs" Tag="Drugs"/>
                            <ComboBoxItem Content="Equipment" Tag="Equipment"/>
                            <ComboBoxItem Content="Flora" Tag="Flora"/>
                            <ComboBoxItem Content="Junk" Tag="Junk"/>
                            <ComboBoxItem Content="Materials" Tag="Materials"/>
                            <ComboBoxItem Content="Medicines" Tag="Medicines"/>
                            <ComboBoxItem Content="Pets" Tag="Pets"/>
                            <ComboBoxItem Content="Seeds" Tag="Seeds"/>
                            <ComboBoxItem Content="Special Items" Tag="SpecialItems"/>
                            <ComboBoxItem Content="Tools" Tag="Tools"/>
                            <ComboBoxItem Content="Valuables" Tag="Valuables"/>
                            <ComboBoxItem Content="Vegetables" Tag="Vegetables"/>
                            <ComboBoxItem Content="Vehicle Parts" Tag="VehicleParts"/>
                            <ComboBoxItem Content="Weapons" Tag="Weapons"/>
                        </ComboBox>

                        <InfoBar x:Name="UnmappedItemsInfoBar"
                                 IsOpen="False"
                                 IsClosable="False"
                                 Severity="Informational"
                                 Title="Some item keys are not catalogued yet"
                                 Message="They remain visible in All with their raw defKey and are preserved on save."/>

                        <InfoBar x:Name="NoItemsInfoBar"
                                 IsOpen="False"
                                 IsClosable="False"
                                 Severity="Informational"
                                 Title="No matching stacks"
                                 Message="Try another storage container or category."/>

                        <ItemsRepeater x:Name="ItemsRepeater">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="288"
                                                   MinItemHeight="232"
                                                   MinColumnSpacing="16"
                                                   MinRowSpacing="16"
                                                   ItemsStretch="Fill"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:InventoryItemViewModel">
                                    <Border Style="{StaticResource CardBorderStyle}" Padding="16">
                                        <StackPanel Spacing="14">
                                            <Grid MinHeight="80" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="56"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Width="56"
                                                        Height="56"
                                                        CornerRadius="8"
                                                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                                                    <Grid>
                                                        <!-- Uncatalogued keys retain a neutral, non-misleading fallback. -->
                                                        <FontIcon Glyph="&#xE7B8;"
                                                                  FontSize="26"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                  Visibility="{x:Bind FallbackIconVisibility, Mode=OneTime}"
                                                                  AutomationProperties.AccessibilityView="Raw"/>
                                                        <Image Source="{x:Bind Icon, Mode=OneTime}"
                                                               Width="52"
                                                               Height="52"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Stretch="Uniform"
                                                               Visibility="{x:Bind IconVisibility, Mode=OneTime}"
                                                               AutomationProperties.AccessibilityView="Raw"/>
                                                    </Grid>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                                    <TextBlock Text="{x:Bind DisplayName, Mode=OneTime}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               MaxLines="3"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTipService.ToolTip="{x:Bind DisplayName, Mode=OneTime}"/>
                                                    <TextBlock Text="{x:Bind CategoryLabel, Mode=OneTime}"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>

                                                <Button Grid.Column="2"
                                                        VerticalAlignment="Top"
                                                        Click="DeleteItemButton_Click"
                                                        CommandParameter="{x:Bind}"
                                                        ToolTipService.ToolTip="Delete item"
                                                        AutomationProperties.Name="{x:Bind DeleteAutomationName, Mode=OneTime}"
                                                        AutomationProperties.AutomationId="{x:Bind DeleteAutomationId, Mode=OneTime}">
                                                    <SymbolIcon Symbol="Delete"
                                                                AutomationProperties.AccessibilityView="Raw"/>
                                                </Button>
                                            </Grid>

                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <NumberBox Grid.Column="0"
                                                           Header="Amount"
                                                           Value="{x:Bind Amount, Mode=TwoWay}"
                                                           SpinButtonPlacementMode="Compact"
                                                           AutomationProperties.Name="{x:Bind AmountAutomationName, Mode=OneTime}"
                                                           AutomationProperties.AutomationId="{x:Bind AmountAutomationId, Mode=OneTime}"/>
                                                <NumberBox Grid.Column="1"
                                                           Header="Integrity"
                                                           Minimum="0"
                                                           Maximum="100"
                                                           SmallChange="1"
                                                           Value="{x:Bind Integrity, Mode=TwoWay}"
                                                           SpinButtonPlacementMode="Compact"
                                                           AutomationProperties.Name="{x:Bind IntegrityAutomationName, Mode=OneTime}"
                                                           AutomationProperties.AutomationId="{x:Bind IntegrityAutomationId, Mode=OneTime}"/>
                                            </Grid>

                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="Quality" VerticalAlignment="Center"/>
                                                <RatingControl MaxRating="3"
                                                               Value="{x:Bind QualityRatingValue, Mode=TwoWay}"
                                                               IsEnabled="{x:Bind IsQualityEditable, Mode=OneTime}"
                                                               IsClearEnabled="False"
                                                               AutomationProperties.Name="{x:Bind QualityAutomationName, Mode=OneTime}"
                                                               AutomationProperties.AutomationId="{x:Bind QualityAutomationId, Mode=OneTime}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollView>

        <ContentDialog x:Name="AddItemDialog"
                       Grid.RowSpan="2"
                       Title="Add item"
                       PrimaryButtonText="Add item"
                       CloseButtonText="Cancel"
                       DefaultButton="Primary"
                       IsPrimaryButtonEnabled="False"
                       PrimaryButtonClick="AddItemDialog_PrimaryButtonClick">
            <Grid MinWidth="480" MaxWidth="560" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="240"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ComboBox x:Name="AddItemCategoryComboBox"
                          Header="Category"
                          SelectedIndex="0"
                          SelectionChanged="AddItemCategoryComboBox_SelectionChanged"
                          AutomationProperties.Name="Filter catalog by category"
                          AutomationProperties.AutomationId="AddItemCategoryComboBox">
                    <ComboBoxItem Content="All categories" Tag="All"/>
                    <ComboBoxItem Content="Ammunition" Tag="Ammunition"/>
                    <ComboBoxItem Content="Books" Tag="Books"/>
                    <ComboBoxItem Content="Consumables" Tag="Consumables"/>
                    <ComboBoxItem Content="Drugs" Tag="Drugs"/>
                    <ComboBoxItem Content="Equipment" Tag="Equipment"/>
                    <ComboBoxItem Content="Flora" Tag="Flora"/>
                    <ComboBoxItem Content="Junk" Tag="Junk"/>
                    <ComboBoxItem Content="Materials" Tag="Materials"/>
                    <ComboBoxItem Content="Medicines" Tag="Medicines"/>
                    <ComboBoxItem Content="Pets" Tag="Pets"/>
                    <ComboBoxItem Content="Seeds" Tag="Seeds"/>
                    <ComboBoxItem Content="Special Items" Tag="SpecialItems"/>
                    <ComboBoxItem Content="Tools" Tag="Tools"/>
                    <ComboBoxItem Content="Valuables" Tag="Valuables"/>
                    <ComboBoxItem Content="Vegetables" Tag="Vegetables"/>
                    <ComboBoxItem Content="Vehicle Parts" Tag="VehicleParts"/>
                    <ComboBoxItem Content="Weapons" Tag="Weapons"/>
                </ComboBox>

                <StackPanel Grid.Row="1" Spacing="4">
                    <TextBlock Text="Search"/>
                    <AutoSuggestBox x:Name="AddItemSearchBox"
                                    PlaceholderText="Item name or defKey"
                                    TextChanged="AddItemSearchBox_TextChanged"
                                    AutomationProperties.Name="Search catalog items"
                                    AutomationProperties.AutomationId="AddItemSearchBox"/>
                </StackPanel>

                <ListView x:Name="AddItemListView"
                          Grid.Row="2"
                          SelectionMode="Single"
                          SelectionChanged="AddItemListView_SelectionChanged"
                          AutomationProperties.Name="Items available to add"
                          AutomationProperties.AutomationId="AddItemListView">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:InventoryItemDefinition">
                            <Grid Padding="4" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Width="40"
                                       Height="40"
                                       Source="{x:Bind ImageAssetPath, Mode=OneTime}"
                                       Stretch="Uniform"
                                       AutomationProperties.AccessibilityView="Raw"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind DisplayName, Mode=OneTime}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{x:Bind DefinitionKey, Mode=OneTime}"
                                               Style="{StaticResource MonospaceTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock x:Name="NoAddItemsTextBlock"
                           Grid.Row="2"
                           Margin="24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="No catalog items match this category and search."
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <Grid Grid.Row="3" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <NumberBox x:Name="AddItemAmountNumberBox"
                               Header="Amount"
                               Minimum="1"
                               Value="1"
                               SpinButtonPlacementMode="Compact"
                               AutomationProperties.Name="New item amount"
                               AutomationProperties.AutomationId="AddItemAmountNumberBox"/>
                    <NumberBox x:Name="AddItemIntegrityNumberBox"
                               Grid.Column="1"
                               Header="Integrity"
                               Minimum="0"
                               Maximum="100"
                               Value="100"
                               SpinButtonPlacementMode="Compact"
                               AutomationProperties.Name="New item integrity"
                               AutomationProperties.AutomationId="AddItemIntegrityNumberBox"/>
                </Grid>

                <StackPanel Grid.Row="4" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Quality" VerticalAlignment="Center"/>
                        <RatingControl x:Name="AddItemQualityRatingControl"
                                       MaxRating="3"
                                       Value="3"
                                       IsClearEnabled="False"
                                       AutomationProperties.Name="New item quality"
                                       AutomationProperties.AutomationId="AddItemQualityRatingControl"/>
                    </StackPanel>
                    <TextBlock x:Name="AddItemQualityHintTextBlock"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </ContentDialog>
    </Grid>
</Page>
