<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SaveOver.Sheltered2.Pages.DonatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <ScrollViewer>
        <!-- MaxWidth keeps line lengths readable on very wide windows; the page still
             shrinks fluidly because every child wraps and nothing has a fixed width. -->
        <StackPanel Margin="36" Spacing="24" MaxWidth="880" HorizontalAlignment="Left">
            <TextBlock Text="Donate"
                       Style="{StaticResource TitleTextBlockStyle}"
                       AutomationProperties.HeadingLevel="Level1"/>

            <TextBlock TextWrapping="Wrap"
                       Text="This save editor is free and open source. If it saved your shelter (or your sanity), consider supporting its development - every contribution helps and is very much appreciated!" />

            <!-- Support platforms -->
            <Border BorderThickness="1"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="Support platforms"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2"/>
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="One-off or recurring - whichever you prefer. All links open in your browser." />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <HyperlinkButton NavigateUri="https://buymeacoffee.com/tsvenbla"
                                         AutomationProperties.Name="Support on Buy Me a Coffee (opens in browser)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Buy Me a Coffee"/>
                                <FontIcon Glyph="&#xE8A7;" FontSize="12" AutomationProperties.AccessibilityView="Raw"/>
                            </StackPanel>
                        </HyperlinkButton>
                        <HyperlinkButton NavigateUri="https://ko-fi.com/tsvenbla"
                                         AutomationProperties.Name="Support on Ko-fi (opens in browser)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8A7;" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                                <TextBlock Text="Ko-fi"/>
                            </StackPanel>
                        </HyperlinkButton>
                        <HyperlinkButton NavigateUri="https://liberapay.com/tsvenbla"
                                         AutomationProperties.Name="Support on Liberapay (opens in browser)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8A7;" FontSize="16" AutomationProperties.AccessibilityView="Raw"/>
                                <TextBlock Text="Liberapay"/>
                            </StackPanel>
                        </HyperlinkButton>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Crypto -->
            <Border BorderThickness="1"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="Cryptocurrency"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2"/>
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Prefer crypto? Copy an address below. Always double-check the first and last characters after pasting - clipboard hijackers exist." />

                    <Grid RowSpacing="12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Image Width="24" Height="24"
                                   Source="ms-appx:///Assets/Donation/bitcoin.svg"
                                   AutomationProperties.AccessibilityView="Raw"/>
                            <TextBlock Text="Bitcoin" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="BitcoinAddressText"
                                   Grid.Row="0" Grid.Column="1"
                                   FontFamily="Consolas"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="bc1qqf3sdgc3l2hqmx0uw0xgul9cmnuanekmwk3ad3"/>
                        <Button Grid.Row="0" Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="CopyAddressButton_Click"
                                Tag="bc1qqf3sdgc3l2hqmx0uw0xgul9cmnuanekmwk3ad3"
                                AutomationProperties.Name="Copy Bitcoin address"
                                ToolTipService.ToolTip="Copy Bitcoin address">
                            <Grid>
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" RenderTransformOrigin="0.5,0.5"
                                          AutomationProperties.AccessibilityView="Raw">
                                    <FontIcon.RenderTransform>
                                        <CompositeTransform/>
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                                <FontIcon Glyph="&#xE73E;" FontSize="14" Opacity="0"
                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                          RenderTransformOrigin="0.5,0.5"
                                          AutomationProperties.AccessibilityView="Raw">
                                    <FontIcon.RenderTransform>
                                        <CompositeTransform/>
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                            </Grid>
                        </Button>

                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Image Width="24" Height="24"
                                   Source="ms-appx:///Assets/Donation/ethereum.svg"
                                   AutomationProperties.AccessibilityView="Raw"/>
                            <TextBlock Text="Ethereum" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="EthereumAddressText"
                                   Grid.Row="1" Grid.Column="1"
                                   FontFamily="Consolas"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="0x895A4ce67b3F1641A441f88db9Ac5201205720C7"/>
                        <Button Grid.Row="1" Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="CopyAddressButton_Click"
                                Tag="0x895A4ce67b3F1641A441f88db9Ac5201205720C7"
                                AutomationProperties.Name="Copy Ethereum address"
                                ToolTipService.ToolTip="Copy Ethereum address">
                            <Grid>
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" RenderTransformOrigin="0.5,0.5"
                                          AutomationProperties.AccessibilityView="Raw">
                                    <FontIcon.RenderTransform>
                                        <CompositeTransform/>
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                                <FontIcon Glyph="&#xE73E;" FontSize="14" Opacity="0"
                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                          RenderTransformOrigin="0.5,0.5"
                                          AutomationProperties.AccessibilityView="Raw">
                                    <FontIcon.RenderTransform>
                                        <CompositeTransform/>
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                            </Grid>
                        </Button>

                        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Image Width="24" Height="24"
                                   Source="ms-appx:///Assets/Donation/cardano.svg"
                                   AutomationProperties.AccessibilityView="Raw"/>
                            <TextBlock Text="Cardano" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="CardanoAddressText"
                                   Grid.Row="2" Grid.Column="1"
                                   FontFamily="Consolas"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="addr1qxpqzlfvg3zsywycy9aztuydr4skr78g7krffkl55cjpvrryq72xda08ngqwt65y7wrq8hw50s2hvzynp8aw2m737mzssektzj"/>
                        <Button Grid.Row="2" Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="CopyAddressButton_Click"
                                Tag="addr1qxpqzlfvg3zsywycy9aztuydr4skr78g7krffkl55cjpvrryq72xda08ngqwt65y7wrq8hw50s2hvzynp8aw2m737mzssektzj"
                                AutomationProperties.Name="Copy Cardano address"
                                ToolTipService.ToolTip="Copy Cardano address">
                            <Grid>
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" RenderTransformOrigin="0.5,0.5"
                                          AutomationProperties.AccessibilityView="Raw">
                                    <FontIcon.RenderTransform>
                                        <CompositeTransform/>
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                                <FontIcon Glyph="&#xE73E;" FontSize="14" Opacity="0"
                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                          RenderTransformOrigin="0.5,0.5"
                                          AutomationProperties.AccessibilityView="Raw">
                                    <FontIcon.RenderTransform>
                                        <CompositeTransform/>
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                            </Grid>
                        </Button>

                        <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Image Width="24" Height="24"
                                   Source="ms-appx:///Assets/Donation/solana.svg"
                                   AutomationProperties.AccessibilityView="Raw"/>
                            <TextBlock Text="Solana" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="SolanaAddressText"
                                   Grid.Row="3" Grid.Column="1"
                                   FontFamily="Consolas"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="8KomFrmvShJ5oCNbwZZXmz4K7ahzuLGURNJ8Wo8tEwzP"/>
                        <Button Grid.Row="3" Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="CopyAddressButton_Click"
                                Tag="8KomFrmvShJ5oCNbwZZXmz4K7ahzuLGURNJ8Wo8tEwzP"
                                AutomationProperties.Name="Copy Solana address"
                                ToolTipService.ToolTip="Copy Solana address">
                            <Grid>
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" RenderTransformOrigin="0.5,0.5"
                                          AutomationProperties.AccessibilityView="Raw">
                                    <FontIcon.RenderTransform>
                                        <CompositeTransform/>
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                                <FontIcon Glyph="&#xE73E;" FontSize="14" Opacity="0"
                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                          RenderTransformOrigin="0.5,0.5"
                                          AutomationProperties.AccessibilityView="Raw">
                                    <FontIcon.RenderTransform>
                                        <CompositeTransform/>
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                            </Grid>
                        </Button>

                        <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Image Width="24" Height="24"
                                   Source="ms-appx:///Assets/Donation/litecoin.svg"
                                   AutomationProperties.AccessibilityView="Raw"/>
                            <TextBlock Text="Litecoin" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="LitecoinAddressText"
                                   Grid.Row="4" Grid.Column="1"
                                   FontFamily="Consolas"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="ltc1q7amegshwzavg7vgqvd7nhx4u4xl3sw70j24chn"/>
                        <Button Grid.Row="4" Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="CopyAddressButton_Click"
                                Tag="ltc1q7amegshwzavg7vgqvd7nhx4u4xl3sw70j24chn"
                                AutomationProperties.Name="Copy Litecoin address"
                                ToolTipService.ToolTip="Copy Litecoin address">
                            <Grid>
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" RenderTransformOrigin="0.5,0.5"
                                          AutomationProperties.AccessibilityView="Raw">
                                    <FontIcon.RenderTransform>
                                        <CompositeTransform/>
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                                <FontIcon Glyph="&#xE73E;" FontSize="14" Opacity="0"
                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                          RenderTransformOrigin="0.5,0.5"
                                          AutomationProperties.AccessibilityView="Raw">
                                    <FontIcon.RenderTransform>
                                        <CompositeTransform/>
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- Announced by screen readers when the copy feedback changes. -->
                    <TextBlock x:Name="CopyFeedbackTextBlock"
                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>

            <TextBlock TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Text="Thank you for supporting open-source software! &#x2764;" />
        </StackPanel>
    </ScrollViewer>
</Page>
