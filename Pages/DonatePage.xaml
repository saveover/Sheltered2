<Page
    x:Class="SaveOver.Sheltered2.Pages.DonatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <ScrollViewer>
        <StackPanel Margin="36,40,36,36" Spacing="32">
            <!-- Intro -->
            <StackPanel Spacing="8">
                <TextBlock Text="Donate"
                           Style="{StaticResource TitleTextBlockStyle}"
                           AutomationProperties.HeadingLevel="Level1"/>
                <TextBlock TextWrapping="Wrap"
                           Text="SaveOver is free and stays free, for everyone. Supporting here funds the time that goes into it, most of which is spent on the unglamorous part: pulling a save format apart byte by byte until it gives up."/>
            </StackPanel>

            <!-- Buy Me a Coffee -->
            <Border BorderThickness="1"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="Buy Me a Coffee"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2"/>

                    <TextBlock TextWrapping="Wrap"
                               Text="A one-off coffee, or a monthly membership. Members get early builds and their name in the release credits. Patrons and Founders also propose and vote on which game gets an editor next."/>

                    <TextBlock TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="This is the only place the memberships live. Roles, votes and early access are all handled here."/>

                    <StackPanel>
                        <HyperlinkButton NavigateUri="https://buymeacoffee.com/saveover"
                                         AutomationProperties.Name="Buy me a coffee (opens buymeacoffee.com in browser)">
                            <Image Height="60">
                                <Image.Source>
                                    <SvgImageSource UriSource="ms-appx:///Assets/Donation/bmc.svg"/>
                                </Image.Source>
                            </Image>
                        </HyperlinkButton>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Other platforms -->
            <Border BorderThickness="1"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="Other platforms"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2"/>

                    <TextBlock TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Already use one of these? One-off tips are welcome there too. Memberships and their perks are handled through Buy Me a Coffee only. All links open in your browser."/>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <HyperlinkButton NavigateUri="https://ko-fi.com/saveover"
                                         AutomationProperties.Name="Tip on Ko-fi (opens in browser)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Ko-fi"/>
                                <FontIcon Glyph="&#xE8A7;" FontSize="12"
                                          AutomationProperties.AccessibilityView="Raw"/>
                            </StackPanel>
                        </HyperlinkButton>

                        <HyperlinkButton NavigateUri="https://patreon.com/saveover"
                                         AutomationProperties.Name="Tip on Patreon (opens in browser)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Patreon"/>
                                <FontIcon Glyph="&#xE8A7;" FontSize="12"
                                          AutomationProperties.AccessibilityView="Raw"/>
                            </StackPanel>
                        </HyperlinkButton>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Crypto -->
            <Border BorderThickness="1"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="Cryptocurrency"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2"/>

                    <InfoBar IsOpen="True"
                             IsClosable="False"
                             Severity="Warning"
                             Title="No perks attached"
                             Message="Crypto transfers are anonymous, so there's no way to tell who sent one or link it to a Discord account. They can't unlock roles, votes, early builds, or credits. They are strictly treated as a one-way thank-you. For the membership perks, use Buy Me a Coffee above."/>

                    <TextBlock TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Copy an address below. Always double-check the first and last characters after pasting; clipboard hijackers exist. Transfers are irreversible and can't be refunded."/>

                    <Grid RowSpacing="12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Bitcoin -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Image Width="24" Height="24"
                                   Source="ms-appx:///Assets/Donation/bitcoin.svg"
                                   AutomationProperties.AccessibilityView="Raw"/>
                            <TextBlock Text="Bitcoin" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="BitcoinAddressText"
                                   Grid.Row="0" Grid.Column="1"
                                   FontFamily="Consolas"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="bc1qqf3sdgc3l2hqmx0uw0xgul9cmnuanekmwk3ad3"/>
                        <Button Grid.Row="0" Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="CopyAddressButton_Click"
                                Tag="bc1qqf3sdgc3l2hqmx0uw0xgul9cmnuanekmwk3ad3"
                                AutomationProperties.Name="Copy Bitcoin address"
                                ToolTipService.ToolTip="Copy Bitcoin address">
                            <Grid>
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" RenderTransformOrigin="0.5,0.5"
                                          AutomationProperties.AccessibilityView="Raw">
                                    <FontIcon.RenderTransform>
                                        <CompositeTransform/>
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                                <FontIcon Glyph="&#xE73E;" FontSize="14" Opacity="0"
                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                          RenderTransformOrigin="0.5,0.5"
                                          AutomationProperties.AccessibilityView="Raw">
                                    <FontIcon.RenderTransform>
                                        <CompositeTransform/>
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                            </Grid>
                        </Button>

                        <!-- Ethereum -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Image Width="24" Height="24"
                                   Source="ms-appx:///Assets/Donation/ethereum.svg"
                                   AutomationProperties.AccessibilityView="Raw"/>
                            <TextBlock Text="Ethereum" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="EthereumAddressText"
                                   Grid.Row="1" Grid.Column="1"
                                   FontFamily="Consolas"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="0x895A4ce67b3F1641A441f88db9Ac5201205720C7"/>
                        <Button Grid.Row="1" Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="CopyAddressButton_Click"
                                Tag="0x895A4ce67b3F1641A441f88db9Ac5201205720C7"
                                AutomationProperties.Name="Copy Ethereum address"
                                ToolTipService.ToolTip="Copy Ethereum address">
                            <Grid>
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" RenderTransformOrigin="0.5,0.5"
                                          AutomationProperties.AccessibilityView="Raw">
                                    <FontIcon.RenderTransform>
                                        <CompositeTransform/>
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                                <FontIcon Glyph="&#xE73E;" FontSize="14" Opacity="0"
                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                          RenderTransformOrigin="0.5,0.5"
                                          AutomationProperties.AccessibilityView="Raw">
                                    <FontIcon.RenderTransform>
                                        <CompositeTransform/>
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                            </Grid>
                        </Button>

                        <!-- Cardano -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Image Width="24" Height="24"
                                   Source="ms-appx:///Assets/Donation/cardano.svg"
                                   AutomationProperties.AccessibilityView="Raw"/>
                            <TextBlock Text="Cardano" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="CardanoAddressText"
                                   Grid.Row="2" Grid.Column="1"
                                   FontFamily="Consolas"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="addr1qxpqzlfvg3zsywycy9aztuydr4skr78g7krffkl55cjpvrryq72xda08ngqwt65y7wrq8hw50s2hvzynp8aw2m737mzssektzj"/>
                        <Button Grid.Row="2" Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="CopyAddressButton_Click"
                                Tag="addr1qxpqzlfvg3zsywycy9aztuydr4skr78g7krffkl55cjpvrryq72xda08ngqwt65y7wrq8hw50s2hvzynp8aw2m737mzssektzj"
                                AutomationProperties.Name="Copy Cardano address"
                                ToolTipService.ToolTip="Copy Cardano address">
                            <Grid>
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" RenderTransformOrigin="0.5,0.5"
                                          AutomationProperties.AccessibilityView="Raw">
                                    <FontIcon.RenderTransform>
                                        <CompositeTransform/>
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                                <FontIcon Glyph="&#xE73E;" FontSize="14" Opacity="0"
                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                          RenderTransformOrigin="0.5,0.5"
                                          AutomationProperties.AccessibilityView="Raw">
                                    <FontIcon.RenderTransform>
                                        <CompositeTransform/>
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                            </Grid>
                        </Button>

                        <!-- Solana -->
                        <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Image Width="24" Height="24"
                                   Source="ms-appx:///Assets/Donation/solana.svg"
                                   AutomationProperties.AccessibilityView="Raw"/>
                            <TextBlock Text="Solana" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="SolanaAddressText"
                                   Grid.Row="3" Grid.Column="1"
                                   FontFamily="Consolas"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="8KomFrmvShJ5oCNbwZZXmz4K7ahzuLGURNJ8Wo8tEwzP"/>
                        <Button Grid.Row="3" Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="CopyAddressButton_Click"
                                Tag="8KomFrmvShJ5oCNbwZZXmz4K7ahzuLGURNJ8Wo8tEwzP"
                                AutomationProperties.Name="Copy Solana address"
                                ToolTipService.ToolTip="Copy Solana address">
                            <Grid>
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" RenderTransformOrigin="0.5,0.5"
                                          AutomationProperties.AccessibilityView="Raw">
                                    <FontIcon.RenderTransform>
                                        <CompositeTransform/>
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                                <FontIcon Glyph="&#xE73E;" FontSize="14" Opacity="0"
                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                          RenderTransformOrigin="0.5,0.5"
                                          AutomationProperties.AccessibilityView="Raw">
                                    <FontIcon.RenderTransform>
                                        <CompositeTransform/>
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                            </Grid>
                        </Button>

                        <!-- Litecoin -->
                        <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Image Width="24" Height="24"
                                   Source="ms-appx:///Assets/Donation/litecoin.svg"
                                   AutomationProperties.AccessibilityView="Raw"/>
                            <TextBlock Text="Litecoin" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="LitecoinAddressText"
                                   Grid.Row="4" Grid.Column="1"
                                   FontFamily="Consolas"
                                   TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="ltc1q7amegshwzavg7vgqvd7nhx4u4xl3sw70j24chn"/>
                        <Button Grid.Row="4" Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="CopyAddressButton_Click"
                                Tag="ltc1q7amegshwzavg7vgqvd7nhx4u4xl3sw70j24chn"
                                AutomationProperties.Name="Copy Litecoin address"
                                ToolTipService.ToolTip="Copy Litecoin address">
                            <Grid>
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" RenderTransformOrigin="0.5,0.5"
                                          AutomationProperties.AccessibilityView="Raw">
                                    <FontIcon.RenderTransform>
                                        <CompositeTransform/>
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                                <FontIcon Glyph="&#xE73E;" FontSize="14" Opacity="0"
                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                          RenderTransformOrigin="0.5,0.5"
                                          AutomationProperties.AccessibilityView="Raw">
                                    <FontIcon.RenderTransform>
                                        <CompositeTransform/>
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                            </Grid>
                        </Button>
                    </Grid>

                    <!-- Announced by screen readers when the copy feedback changes. -->
                    <TextBlock x:Name="CopyFeedbackTextBlock"
                               Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>

            <!-- Other ways to help -->
            <Border BorderThickness="1"
                    CornerRadius="{StaticResource OverlayCornerRadius}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    Padding="24">
                <StackPanel Spacing="12">
                    <TextBlock Text="Other ways to help"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2"/>

                    <TextBlock TextWrapping="Wrap"
                               Text="Money is only one kind of contribution. A precise bug report, a save file that reproduces something odd, or an answer to someone stuck in #support all move the project along just as much."/>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <HyperlinkButton NavigateUri="https://discord.gg/nzQSeGcta8"
                                         AutomationProperties.Name="Join the SaveOver Discord (opens in browser)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Join the Discord"/>
                                <FontIcon Glyph="&#xE8A7;" FontSize="12"
                                          AutomationProperties.AccessibilityView="Raw"/>
                            </StackPanel>
                        </HyperlinkButton>

                        <HyperlinkButton NavigateUri="https://github.com/saveover/Sheltered2/issues"
                                         AutomationProperties.Name="Report an issue on GitHub (opens in browser)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Report an issue"/>
                                <FontIcon Glyph="&#xE8A7;" FontSize="12"
                                          AutomationProperties.AccessibilityView="Raw"/>
                            </StackPanel>
                        </HyperlinkButton>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Text="Thank you for supporting open-source software! &#x2764;"/>
        </StackPanel>
    </ScrollViewer>
</Page>