<Page
    x:Class="SaveOver.Sheltered2.Pages.DonatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pages="using:SaveOver.Sheltered2.Pages"
    mc:Ignorable="d"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <!-- Every section on this page is the same card. -->
        <Style x:Key="DonateCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}"/>
            <Setter Property="Padding" Value="24"/>
        </Style>

        <!-- Label plus the "leaves the app" glyph, shared by every off-app link.
             The bound value is the button's own Content. -->
        <DataTemplate x:Key="ExternalLinkTemplate">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding}"/>
                <FontIcon Glyph="&#xE8A7;" FontSize="12"
                          AutomationProperties.AccessibilityView="Raw"/>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel x:Name="RootPanel"
                    Margin="36,40,36,36"
                    Spacing="32">

            <!-- Intro -->
            <StackPanel Spacing="12">
                <TextBlock Text="Donate"
                           Style="{StaticResource TitleTextBlockStyle}"
                           AutomationProperties.HeadingLevel="Level1"/>
                <TextBlock TextWrapping="Wrap"
                           Text="SaveOver's software is free for everyone and stays that way. Donating pays for the time that goes into building editors for more games, keeping the existing ones working when a patch changes a save format, and helping people whose saves won't open."/>
                <TextBlock TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Memberships and the perks that come with them live on Buy Me a Coffee. Everything else below is a one-off thank-you."/>
            </StackPanel>

            <!-- Buy Me a Coffee -->
            <Border Style="{StaticResource DonateCardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Buy Me a Coffee"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2"/>

                    <TextBlock TextWrapping="Wrap"
                               Text="A one-off coffee, or a monthly membership. Members get early builds and their name in the release credits. The Patron and Founder tiers also propose and vote on which game gets an editor next."/>

                    <InfoBar IsOpen="True"
                             IsClosable="False"
                             Severity="Informational"
                             Title="Perks are granted here"
                             Message="Memberships run through Buy Me a Coffee only. Roles, votes, early access and credits are all handled from here, so this is the option to pick if you want them."/>

                    <HyperlinkButton NavigateUri="https://buymeacoffee.com/saveover"
                                     HorizontalAlignment="Left"
                                     AutomationProperties.Name="Support on Buy Me a Coffee (opens in your browser)">
                        <Image Height="60"
                               Source="ms-appx:///Assets/Donation/bmc.svg"
                               AutomationProperties.AccessibilityView="Raw"/>
                    </HyperlinkButton>
                </StackPanel>
            </Border>

            <!-- Other platforms -->
            <Border Style="{StaticResource DonateCardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Other platforms"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2"/>

                    <TextBlock TextWrapping="Wrap"
                               Text="Already have an account on Ko-fi or Patreon? A one-off donation is just as welcome there."/>

                    <InfoBar IsOpen="True"
                             IsClosable="False"
                             Severity="Informational"
                             Title="No perks attached"
                             Message="The project doesn't run memberships on Ko-fi or Patreon, so anything sent there is treated as a one-off thank-you. It can't unlock roles, votes, early builds or credits."/>

                    <StackPanel x:Name="PlatformLinks"
                                Orientation="Horizontal"
                                Spacing="12"
                                HorizontalAlignment="Left">
                        <HyperlinkButton NavigateUri="https://ko-fi.com/saveover"
                                         Content="Ko-fi"
                                         ContentTemplate="{StaticResource ExternalLinkTemplate}"
                                         AutomationProperties.Name="Donate on Ko-fi (opens in your browser)"/>

                        <HyperlinkButton NavigateUri="https://patreon.com/saveover"
                                         Content="Patreon"
                                         ContentTemplate="{StaticResource ExternalLinkTemplate}"
                                         AutomationProperties.Name="Donate on Patreon (opens in your browser)"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Cryptocurrency -->
            <Border Style="{StaticResource DonateCardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Cryptocurrency"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2"/>

                    <TextBlock TextWrapping="Wrap"
                               Text="Send straight to one of the wallets below. Nothing to sign up for and no account needed."/>

                    <InfoBar IsOpen="True"
                             IsClosable="False"
                             Severity="Warning"
                             Title="No perks attached, and no refunds"
                             Message="Crypto transfers are anonymous, so there's no way to tell who sent one or tie it to a Discord account. It can't unlock roles, votes, early builds or credits. Transfers are also final and can't be reversed, so send only what you mean to."/>

                    <TextBlock TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Copy an address below, then check the first and last characters after pasting. Clipboard hijackers exist."/>

                    <!-- One row per wallet: the name sits above the address so a long address
                         gets the full card width instead of being squeezed into a column. -->
                    <ItemsRepeater ItemsSource="{x:Bind Wallets}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="8"/>
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="pages:CryptoWallet">
                                <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="12,8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Image Width="20" Height="20"
                                                       Source="{x:Bind Icon}"
                                                       AutomationProperties.AccessibilityView="Raw"/>
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Address}"
                                                       FontFamily="Consolas"
                                                       TextWrapping="Wrap"
                                                       IsTextSelectionEnabled="True"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>

                                        <!-- The two icons overlap and cross-fade on copy; the
                                             code-behind expects copy first, checkmark second. -->
                                        <Button Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Padding="8"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="CopyAddressButton_Click"
                                                Tag="{x:Bind Address}"
                                                AutomationProperties.Name="{x:Bind CopyLabel}"
                                                ToolTipService.ToolTip="{x:Bind CopyLabel}">
                                            <Grid>
                                                <FontIcon Glyph="&#xE8C8;" FontSize="14"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                          AutomationProperties.AccessibilityView="Raw"/>
                                                <FontIcon Glyph="&#xE73E;" FontSize="14" Opacity="0"
                                                          Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                          AutomationProperties.AccessibilityView="Raw"/>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <!-- Announced by screen readers when the copy feedback changes. -->
                    <TextBlock x:Name="CopyFeedbackTextBlock"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>

            <!-- Other ways to help -->
            <Border Style="{StaticResource DonateCardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Other ways to help"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               AutomationProperties.HeadingLevel="Level2"/>

                    <TextBlock TextWrapping="Wrap"
                               Text="Donating is only one kind of contribution. A precise bug report, a save file that reproduces something odd, or a pull request all move the project along just as much."/>

                    <StackPanel x:Name="HelpLinks"
                                Orientation="Horizontal"
                                Spacing="12"
                                HorizontalAlignment="Left">
                        <HyperlinkButton NavigateUri="https://discord.gg/nzQSeGcta8"
                                         Content="Join the Discord"
                                         ContentTemplate="{StaticResource ExternalLinkTemplate}"
                                         AutomationProperties.Name="Join the SaveOver Discord (opens in your browser)"/>

                        <HyperlinkButton NavigateUri="https://github.com/saveover/Sheltered2/issues"
                                         Content="Report an issue"
                                         ContentTemplate="{StaticResource ExternalLinkTemplate}"
                                         AutomationProperties.Name="Report an issue on GitHub (opens in your browser)"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Text="Thank you for supporting open-source software! &#x2764;"/>
        </StackPanel>
    </ScrollViewer>
</Page>
