<Page
    x:Class="SaveOver.Sheltered2.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pages="using:SaveOver.Sheltered2.Pages"
    NavigationCacheMode="Enabled">

    <Page.Resources>
        <!-- One "what you can edit" tile. -->
        <DataTemplate x:Key="EditorFeatureTemplate" x:DataType="pages:EditorFeature">
            <Border Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="8">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <IconSourceElement IconSource="{x:Bind Icon}"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       AutomationProperties.AccessibilityView="Raw"/>
                    <StackPanel>
                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind Summary}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Outside the scroller, so it stays put while the cards move under it. -->
        <TextBlock Margin="36,24,36,0"
                   Style="{StaticResource TitleTextBlockStyle}"
                   TextWrapping="Wrap"
                   Text="Sheltered 2 Save Editor"
                   AutomationProperties.HeadingLevel="Level1"/>

        <!-- The inset goes on the content, not on the ScrollView: ScrollView.Padding shrinks the
             viewport instead, which clips the content short of the edges and leaves dead bands. -->
        <ScrollView Grid.Row="1">
            <StackPanel Margin="36,16,36,36" Spacing="32">
                <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Modify your game saves with ease!" />
                <TextBlock TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Text="Edit characters, pets, inventory, crafting materials, and faction relationships in your Sheltered 2 save files." />
            </StackPanel>

            <!-- Getting Started Card -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon
                            Glyph="&#xE80F;"
                            FontSize="20"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            AutomationProperties.AccessibilityView="Raw" />
                        <TextBlock
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Getting Started"
                            AutomationProperties.HeadingLevel="Level2" />
                    </StackPanel>

                    <TextBlock
                        TextWrapping="Wrap"
                        Text="Load a Sheltered 2 save file to begin editing. Save files are typically found in:" />

                    <Border Style="{StaticResource InsetBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Style="{StaticResource MonospaceTextBlockStyle}"
                                Text="%userprofile%\AppData\LocalLow\Unicube\Sheltered2"
                                VerticalAlignment="Center" />

                            <!-- The copy glyph and the checkmark sit on top of each other and are
                                 swapped by CopyIconFeedback, which reads them in order: copy
                                 first, checkmark second, the checkmark starting invisible. -->
                            <Button Grid.Column="1"
                                    x:Name="CopyPathButton"
                                    Style="{StaticResource IconButtonStyle}"
                                    Click="CopyPathButton_Click"
                                    Margin="8,0,0,0"
                                    AutomationProperties.Name="Copy save folder path"
                                    ToolTipService.ToolTip="Copy path to clipboard">
                                <Grid>
                                    <FontIcon Glyph="&#xE8C8;" FontSize="14"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              AutomationProperties.AccessibilityView="Raw"/>
                                    <FontIcon Glyph="&#xE73E;" FontSize="14" Opacity="0"
                                              Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                              AutomationProperties.AccessibilityView="Raw"/>
                                </Grid>
                            </Button>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="LoadFileButton" 
                                Click="LoadFileButton_Click"
                                Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8E5;" FontSize="16"/>
                                <TextBlock Text="Load Save File"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SaveFileButton" 
                                IsEnabled="False" 
                                Click="SaveFileButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74E;" FontSize="16"/>
                                <TextBlock Text="Save Changes"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Carries every load/save outcome, including failures, so it is announced. -->
                    <TextBlock x:Name="LoadFileTextBlock"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>

            <!-- Features Overview -->
            <StackPanel Spacing="20">
                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="What You Can Edit"
                    AutomationProperties.HeadingLevel="Level2" />

                <!-- Two columns that collapse to one when the page gets narrow, which the fixed
                     two-column Grid this replaced never did. -->
                <ItemsRepeater ItemsSource="{x:Bind Features}"
                               ItemTemplate="{StaticResource EditorFeatureTemplate}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="240"
                                           MinColumnSpacing="16"
                                           MinRowSpacing="8"
                                           MaximumRowsOrColumns="2"
                                           ItemsStretch="Fill"/>
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>

            <!-- Important Notice -->
            <InfoBar IsOpen="True" 
                     Severity="Warning" 
                     IsClosable="False"
                     Title="Important Legal Notice"
                     Message="This software is provided 'as is' without warranty. Always backup your save files before editing. Use at your own risk.">
                <InfoBar.ActionButton>
                    <HyperlinkButton Content="View License" NavigateUri="https://github.com/saveover/Sheltered2/blob/master/LICENSE.txt" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Support Section -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xEB51;"
                                  FontSize="20"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  AutomationProperties.AccessibilityView="Raw"/>
                        <TextBlock
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Open Source Project"
                            AutomationProperties.HeadingLevel="Level2" />
                    </StackPanel>

                    <TextBlock
                        TextWrapping="Wrap"
                        Text="This is a free, open-source project. If you find it useful, consider supporting its development through donations or contributions." />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <HyperlinkButton NavigateUri="https://github.com/saveover/Sheltered2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8A7;" FontSize="16"/>
                                <TextBlock Text="View on GitHub"/>
                            </StackPanel>
                        </HyperlinkButton>
                        <Button Click="SupportButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEB51;" FontSize="16"/>
                                <TextBlock Text="Support Development"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
            </StackPanel>
        </ScrollView>
    </Grid>
</Page>
