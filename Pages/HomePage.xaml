<Page
    x:Class="SaveOver.Sheltered2.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <ScrollViewer>
        <StackPanel Margin="36,40,36,36" Spacing="32">
            <!-- Hero Section -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="12">
                    <TextBlock
                        Style="{StaticResource TitleLargeTextBlockStyle}"
                        Text="Sheltered 2 Save Editor" />
                    <TextBlock
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Modify your game saves with ease!" />
                    <TextBlock
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="Edit characters, pets, inventory, crafting materials, and faction relationships in your Sheltered 2 save files." />
                </StackPanel>
            </Grid>

            <!-- Getting Started Card -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon
                            Glyph="&#xE80F;"
                            FontSize="20"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Getting Started" />
                    </StackPanel>

                    <TextBlock
                        TextWrapping="Wrap"
                        Text="Load a Sheltered 2 save file to begin editing. Save files are typically found in:" />

                    <Border Style="{StaticResource InsetBorderStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Style="{StaticResource MonospaceTextBlockStyle}"
                                Text="%userprofile%\AppData\LocalLow\Unicube\Sheltered2"
                                VerticalAlignment="Center" />

                            <!-- The copy glyph and the checkmark sit on top of each other and are
                                 swapped by CopyIconFeedback, which reads them in order: copy
                                 first, checkmark second, the checkmark starting invisible. -->
                            <Button Grid.Column="1"
                                    x:Name="CopyPathButton"
                                    Style="{StaticResource IconButtonStyle}"
                                    Click="CopyPathButton_Click"
                                    Margin="8,0,0,0"
                                    AutomationProperties.Name="Copy save folder path"
                                    ToolTipService.ToolTip="Copy path to clipboard">
                                <Grid>
                                    <FontIcon Glyph="&#xE8C8;" FontSize="14"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                              AutomationProperties.AccessibilityView="Raw"/>
                                    <FontIcon Glyph="&#xE73E;" FontSize="14" Opacity="0"
                                              Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                              AutomationProperties.AccessibilityView="Raw"/>
                                </Grid>
                            </Button>
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="LoadFileButton" 
                                Click="LoadFileButton_Click"
                                Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8E5;" FontSize="16"/>
                                <TextBlock Text="Load Save File"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="SaveFileButton" 
                                IsEnabled="False" 
                                Click="SaveFileButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74E;" FontSize="16"/>
                                <TextBlock Text="Save Changes"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock x:Name="LoadFileTextBlock" 
                               VerticalAlignment="Center" 
                               TextWrapping="Wrap" 
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Features Overview -->
            <StackPanel Spacing="20">
                <TextBlock
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="What You Can Edit" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Characters -->
                    <Border Grid.Row="0" Grid.Column="0" 
                            Margin="0,0,8,8"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <SymbolIcon Symbol="People" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <StackPanel>
                                <TextBlock Text="Characters" FontWeight="SemiBold"/>
                                <TextBlock Text="Stats, skills, traits" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Pets -->
                    <Border Grid.Row="0" Grid.Column="1" 
                            Margin="8,0,0,8"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xEA79;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <StackPanel>
                                <TextBlock Text="Pets" FontWeight="SemiBold"/>
                                <TextBlock Text="Health, happiness, stats" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Inventory -->
                    <Border Grid.Row="1" Grid.Column="0" 
                            Margin="0,0,8,8"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE7B8;" FontSize="22" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <StackPanel>
                                <TextBlock Text="Inventory" FontWeight="SemiBold"/>
                                <TextBlock Text="Items, quantities" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Crafting -->
                    <Border Grid.Row="1" Grid.Column="1" 
                            Margin="8,0,0,8"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <SymbolIcon Symbol="Repair" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <StackPanel>
                                <TextBlock Text="Crafting" FontWeight="SemiBold"/>
                                <TextBlock Text="Materials, recipes" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Factions -->
                    <Border Grid.Row="2" Grid.Column="0" 
                            Margin="0,0,8,0"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <SymbolIcon Symbol="Flag" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <StackPanel>
                                <TextBlock Text="Factions" FontWeight="SemiBold"/>
                                <TextBlock Text="Relationships, reputation" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- Important Notice -->
            <InfoBar IsOpen="True" 
                     Severity="Warning" 
                     IsClosable="False"
                     Title="Important Legal Notice"
                     Message="This software is provided 'as is' without warranty. Always backup your save files before editing. Use at your own risk.">
                <InfoBar.ActionButton>
                    <HyperlinkButton Content="View License" NavigateUri="https://github.com/tsvenbla/Sheltered2SaveEditor/blob/master/LICENSE.txt" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Support Section -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xEB51;"
                                  FontSize="20"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                        <TextBlock
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Open Source Project" />
                    </StackPanel>

                    <TextBlock
                        TextWrapping="Wrap"
                        Text="This is a free, open-source project. If you find it useful, consider supporting its development through donations or contributions." />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <HyperlinkButton NavigateUri="https://github.com/tsvenbla/Sheltered2SaveEditor">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8A7;" FontSize="16"/>
                                <TextBlock Text="View on GitHub"/>
                            </StackPanel>
                        </HyperlinkButton>
                        <Button Click="SupportButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEB51;" FontSize="16"/>
                                <TextBlock Text="Support Development"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
