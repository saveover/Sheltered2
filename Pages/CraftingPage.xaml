<Page
    x:Class="SaveOver.Sheltered2.Pages.CraftingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">

    <!-- The title sits outside the scroller so it stays put as the page scrolls. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Margin="36,24,36,0"
                   Text="Crafting"
                   Style="{StaticResource TitleTextBlockStyle}"
                   AutomationProperties.HeadingLevel="Level1"/>

        <ScrollView Grid.Row="1">
            <StackPanel Margin="36,16,36,36" Spacing="24" MaxWidth="1100" HorizontalAlignment="Left">

            <InfoBar IsOpen="True"
                     IsClosable="False"
                     Severity="Informational"
                     Title="Not built yet"
                     Message="Crafting material and recipe editing is still being worked on. Your save is loaded and untouched - nothing on this page can change it."/>
            </StackPanel>
        </ScrollView>
    </Grid>
</Page>
